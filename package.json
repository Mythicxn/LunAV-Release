{
  "name": "lunav-launcher",
  "version": "1.0.2",
  "description": "LunAV Launcher",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.mythicxn.lunav.launcher",
    "productName": "LunAV Launcher",
    "artifactName": "LunAV-Launcher.${ext}",
    "win": {
      "icon": "icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "files": [
      "**/*",
      "!README.md"
    ]
  }
}
